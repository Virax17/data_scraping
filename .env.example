# Copy to .env (project root) and fill in real values. Never commit .env.

# Apollo
APOLLO_API_KEY=your-apollo-api-key

# Lusha
LUSHA_API_KEY=your-lusha-api-key

# MongoDB Atlas
# If mongodb+srv:// fails on your network (SRV DNS lookups blocked), use the
# plain mongodb:// form listing the three shard hosts from Atlas's
# "connect -> drivers -> older version" connection string instead.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB=tritorc_enrich

# Cerebras (free tier judge engine). Extra keys are comma-separated and
# round-robined, each paced at 5 req/min.
CEREBRAS_API_KEY=your-cerebras-key
CEREBRAS_API_KEYS=key2,key3,key4
