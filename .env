# Copy to server/.env and fill in real values.

# Apollo
APOLLO_API_KEY=c0mUNwJ2ID376mKSfTu8kw

# Lusha
LUSHA_API_KEY=c3eacb43-9934-4931-8391-7fcf23319eabfgd


# Server
PORT=3001
NODE_ENV=development

# Limits
MAX_CREDITS_PER_RUN=5000
MAX_CONTACTS_PER_COMPANY=5
MIN_CONTACTS_PER_COMPANY=3
API_CONCURRENCY=2
API_REQUESTS_PER_SECOND=3

# Output
INCLUDE_MATCH_METADATA=true

# Set to false to skip Apollo bulk_match + Lusha entirely (no contact
# credits spent) and write rows straight from the free People Search
# results — Result: Search_Only, no email/phone. Org Enrich (1 credit/co.)
# still runs since classification needs it.
ENRICH_CONTACTS=false

# Webhook (v1 — phone reveal, not yet wired up)
WEBHOOK_BASE_URL=https://your-domain.com/api/webhook/apollo

# MongoDB Atlas (from D:/tritorc/atlas-credentials.env)
# ORIGINAL (mongodb+srv, broken on this network -- SRV DNS queries are blocked/mangled locally):
# MONGO_URI=mongodb+srv://ai_db_user:dMbcqS8rg37uRvNA@cluster0.vdcddlh.mongodb.net/?appName=Cluster0&compressors=zlib
MONGO_URI=mongodb://ai_db_user:dMbcqS8rg37uRvNA@ac-rkvps9f-shard-00-00.vdcddlh.mongodb.net:27017,ac-rkvps9f-shard-00-01.vdcddlh.mongodb.net:27017,ac-rkvps9f-shard-00-02.vdcddlh.mongodb.net:27017/?replicaSet=atlas-4qn6vu-shard-0&authSource=admin&retryWrites=true&w=majority&tls=true&appName=Cluster0&compressors=zlib
MONGO_DB=tritorc_enrich

# Cerebras (free tier — judge engine for local testing)
CEREBRAS_API_KEY=csk-f5wkenv9jp6mkkev4fpd2e2yrmy8hcwydkdcpyx23pt5ve9t

# Additional Cerebras keys (comma-separated) — the client round-robins across
